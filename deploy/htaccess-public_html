# Place in public_html ONLY if you cannot point the domain's document root at fspra/public.
# Prefer: cPanel > Domains > fidelity-southview.co.zw > Document Root = /home/USER/fspra/public
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
    RewriteRule ^(.*)$ /fspra/public/$1 [L]
</IfModule>

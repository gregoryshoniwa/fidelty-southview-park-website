APP_NAME="Fidelity Southview Park Residents Association"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fidelity-southview.co.zw
APP_TIMEZONE=Africa/Harare
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_fspra
DB_USERNAME=cpaneluser_fspra
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=fidelity-southview.co.zw,www.fidelity-southview.co.zw

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Branded emails go out from the association's own cPanel mailbox (SPF, DKIM and DMARC already published).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.fidelity-southview.co.zw
MAIL_PORT=465
MAIL_USERNAME=info@fidelity-southview.co.zw
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@fidelity-southview.co.zw
MAIL_FROM_NAME="Southview Park Residents"

SITE_DOMAIN=fidelity-southview.co.zw
ID_HASH_SALT=
PAYMENTS_LIVE=false

SMS_DRIVER=http
SMS_DAILY_CAP=1500
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=FSPRA

# manual = committee confirms each stand in /admin until Fidelity's API is connected
FIDELITY_DRIVER=manual
FIDELITY_BASE_URL=
FIDELITY_API_KEY=

# Payments stay off (PAYMENTS_LIVE=false). Set http + a 32+ character webhook secret when the bank is ready.
TNCB_DRIVER=http
TNCB_BASE_URL=
TNCB_MERCHANT_ID=
TNCB_API_KEY=
TNCB_WEBHOOK_SECRET=

# Firebase Authentication: Google sign-in (free) and phone SMS codes. Email sign-in uses our own mailbox, not Firebase.
# Phone codes via Firebase need the Blaze plan: US$0.09 per SMS to Zimbabwe, first 10 SMS a day free.
FIREBASE_PROJECT_ID=fidelity-southview-park
FIREBASE_API_KEY=AIzaSyC-2rjVpa48HQ7bdsoJx544cS0lGIzWg9c
FIREBASE_AUTH_DOMAIN=fidelity-southview-park.firebaseapp.com
FIREBASE_APP_ID=1:560762482469:web:aa772e64357ef91ac034cc
FIREBASE_PROVIDERS=google
# firebase = SMS codes through Firebase; local = your own bulk SMS gateway (cheaper at volume)
AUTH_PHONE_PROVIDER=firebase

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash
ASSISTANT_DAILY_TOKEN_CAP=2000000
ASSISTANT_DAILY_VOICE_SESSIONS=150
# The site is behind Cloudflare's proxy: trust only Cloudflare's ranges (https://www.cloudflare.com/ips/)
# so rate limits and audit logs see each visitor's real IP. Re-check the list once a year.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/222400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

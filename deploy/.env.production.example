APP_NAME="Fidelity Southview Park Residents Association"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fidelity-southview.co.zw
APP_TIMEZONE=Africa/Harare
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_fspra
DB_USERNAME=cpaneluser_fspra
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=fidelity-southview.co.zw,www.fidelity-southview.co.zw

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=mail.fidelity-southview.co.zw
MAIL_PORT=465
MAIL_USERNAME=no-reply@fidelity-southview.co.zw
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@fidelity-southview.co.zw
MAIL_FROM_NAME="${APP_NAME}"

SITE_DOMAIN=fidelity-southview.co.zw
ID_HASH_SALT=
PAYMENTS_LIVE=false

SMS_DRIVER=http
SMS_DAILY_CAP=1500
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=FSPRA

# manual = committee confirms each stand in /admin until Fidelity's API is connected
FIDELITY_DRIVER=manual
FIDELITY_BASE_URL=
FIDELITY_API_KEY=

# Payments stay off (PAYMENTS_LIVE=false). Set http + a 32+ character webhook secret when the bank is ready.
TNCB_DRIVER=http
TNCB_BASE_URL=
TNCB_MERCHANT_ID=
TNCB_API_KEY=
TNCB_WEBHOOK_SECRET=

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash
ASSISTANT_DAILY_TOKEN_CAP=2000000
ASSISTANT_DAILY_VOICE_SESSIONS=150
# Set only if you put Cloudflare or another proxy in front (comma-separated proxy IPs)
TRUSTED_PROXIES=
